# Copy to .env on the server (never commit .env). Read by src/lib/server/*.
DATABASE_URL=postgres://postgres:PASSWORD@192.168.146.115:5432/UrbanPortalDBP
# Public origin, used for absolute links in emails.
PUBLIC_ORIGIN=https://www.urbanprospects.com.au
# Set to 0 when serving over plain http (local dev). Session cookie is Secure otherwise.
COOKIE_SECURE=1
# Outbound mail. Postmark (HTTP API) is preferred; SMTP is the fallback; with
# neither set the message is logged to stdout instead of sent (dev/staging).
# MAIL_FROM must be on a verified Postmark sender signature. Only
# app.urbanprospects.com.au is DKIM-verified on the Postmark account; the root
# domain is not, so sends from @urbanprospects.com.au are rejected.
POSTMARK_TOKEN=
POSTMARK_STREAM=outbound
# SMTP fallback. Leave SMTP_HOST empty to skip it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Urban Prospects <no-reply@app.urbanprospects.com.au>"
MAIL_REPLY_TO=info@urbanprospects.com.au
# adapter-node
PORT=3010
ORIGIN=https://www.urbanprospects.com.au

# Stripe (platform subscription checkout, src/routes/api/checkout). Live prices
# per region count: M = monthly, A = annual. Quantity on the line item = users.
STRIPE_SECRET_KEY=
# Publishable key for the card element on /account/ (Update card).
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_REGION_1M=price_1Toe1JFaOhZcnlWd8ZGNhfja
STRIPE_PRICE_REGION_2M=price_1Toe1KFaOhZcnlWdb9JNY6zL
STRIPE_PRICE_REGION_3M=price_1Toe1KFaOhZcnlWdIb23CApt
STRIPE_PRICE_REGION_4M=price_1Toe1KFaOhZcnlWdCLBqHbZf
STRIPE_PRICE_REGION_5M=price_1Toe1LFaOhZcnlWdlJqZZzKR
STRIPE_PRICE_REGION_1A=price_1Toe1LFaOhZcnlWdcJN3KHyI
STRIPE_PRICE_REGION_2A=price_1Toe1LFaOhZcnlWd2O0QiMt2
STRIPE_PRICE_REGION_3A=price_1Toe1MFaOhZcnlWdULzI3BAd
STRIPE_PRICE_REGION_4A=price_1Toe1MFaOhZcnlWdlNU0dWTr
STRIPE_PRICE_REGION_5A=price_1Toe1MFaOhZcnlWdmP1mXtws
# Optional: a 10%-off-forever coupon applied when users > 1 (matches the page).
STRIPE_COUPON_MULTI_USER=
# One-off Property Intelligence Report ($250 per site, mode=payment, guest checkout).
STRIPE_PRICE_REPORT=price_1UDCidFaOhZcnlWdkB4BMc3S

# Hazlett (NSW LRS broker) title search / plan image search — docs/hazlett-api.md,
# src/lib/server/hazlett.ts. mock (default) returns a sample PDF and places no LRS order.
# live mints its own 28-day OAuth token from oauth.hazlett.com.au (client id + secret from
# credentials.md, username URBAN) and orders on HAZLETT_BASE_URL. Every live order is charged.
HAZLETT_MODE=mock
HAZLETT_BASE_URL=https://api.hazlett.com.au
HAZLETT_OAUTH_URL=https://oauth.hazlett.com.au
HAZLETT_CLIENT_ID=9fysIFgDj2zO8Ad1Qt1u3BEN
HAZLETT_CLIENT_SECRET=
HAZLETT_USERNAME=URBAN
# Optional static override "<access_token>.<client_id>"; leave empty to use OAuth above.
HAZLETT_TOKEN=
HAZLETT_TIMEOUT_MS=60000
# How long to poll an "In Progress" document before emailing without it.
HAZLETT_POLL_SECONDS=90
# Postmark caps a message at 10MB; larger PDFs (plan images can be 50MB) are not attached.
HAZLETT_MAX_ATTACH_MB=9
# Document emails go to the buyer. TITLE_SEARCH_BCC gets a copy of every one (interim);
# TITLE_SEARCH_RECIPIENT, if set, overrides the recipient entirely (soft-launch only).
TITLE_SEARCH_BCC=danny@moble.com.au
TITLE_SEARCH_RECIPIENT=
# Where purchased PDFs are kept (served from /account/documents/<id>/). MUST be outside the
# deploy dir — a deploy replaces /opt/www/upweb-node wholesale. Writable by the service user.
TITLE_DOCS_DIR=/opt/www/upweb-data/title-docs
# Collector: how often the pending-order pass runs, and when to stop polling an image order.
HAZLETT_COLLECT_INTERVAL_MS=60000
HAZLETT_COLLECT_MAX_DAYS=5
# Accounts that never pay for title / plan / dealing searches (comma list). Everyone else
# pays $25 per item through Stripe Checkout (mode=payment) before anything is ordered.
TITLE_SEARCH_FREE_EMAILS=stuart@urbanperspectives.com.au
# Members can re-download a purchased document for this many days; the file is kept on disk
# afterwards (admins can still fetch it) but the member's link closes.
TITLE_DOWNLOAD_DAYS=90
