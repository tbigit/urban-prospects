# Copy to .env on the server (never commit .env). Read by src/lib/server/*.
DATABASE_URL=postgres://postgres:PASSWORD@192.168.146.115:5432/UrbanPortalDBP
# Public origin, used for absolute links in emails.
PUBLIC_ORIGIN=https://www.urbanprospects.com.au
# Set to 0 when serving over plain http (local dev). Session cookie is Secure otherwise.
COOKIE_SECURE=1
# SMTP for password-reset mail. Leave SMTP_HOST empty to log the mail to stdout instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Urban Prospects <no-reply@urbanprospects.com.au>"
# adapter-node
PORT=3000
ORIGIN=https://www.urbanprospects.com.au

# Stripe (platform subscription checkout, src/routes/api/checkout). Live prices
# per region count: M = monthly, A = annual. Quantity on the line item = users.
STRIPE_SECRET_KEY=
